}
}}
<style>
    .dropdown-scrollable {
        max-height: 190px;
        overflow-y: auto;
    }
</style>
<div class="content-bank-container my-5">
    <div class="mb-2">
        {{#allowedcontexts}}
        {{> core/single_select }}
        {{/allowedcontexts}}
    </div>
    <div class="d-flex justify-content-between">
        <div class="mb-2 mr-2 w-100">
            {{< core/search_input_auto }}
            {{$label}}{{#str}}
                search, core
            {{/str}}{{/label}}
            {{$placeholder}}{{#str}}
                searchcontentbankbyname, local_coursebank
            {{/str}}{{/placeholder}}
            {{/ core/search_input_auto }}
        </div>
        <div class="mb-2 d-flex">
            {{#tools}}
            {{#dropdown}}
            {{>core_contentbank/bankcontent/toolbar_dropdown}}
            {{/dropdown}}
            {{^dropdown}}
            <a href="{{ link }}" class="icon-no-margin btn btn-secondary text-nowrap" title="{{ name }}"
                data-action="{{ action }}">
                {{#pix}} {{{ icon }}} {{/pix}} {{{ name }}}
            </a>
            {{/dropdown}}
            {{/tools}}
            <a class="icon-no-margin btn btn-secondary text-nowrap" title="upload" data-action="upload">
                <i class="icon fa fa-upload fa-fw" aria-hidden="true"></i> upload
            </a>
        </div>
    </div>
    <div class="pb-3 border">
        <div class="bg-light p-2 border-bottom">
            {{#pix}} i/folder {{/pix}}
        </div>
        <div class="p-3 d-flex flex-wrap justify-content-start align-items-center" data-region="filearea">
            {{#coursebank}}
            <div class="m-4 fileitem" style="width: 100px;">
                {{#h5picon}}
                {{#icon}}
                <a href="view.php?contextid={{contextid}}&id={{id}}" data-name="{{name}}"
                    class="text-center clamp-2 word-break-all">
                    <img src="{{icon}}" alt="not img" class="mb-2" style="height: 64px; width: 100px;">
                    <p>{{name}}</p>
                </a>
                {{/icon}}
                {{/h5picon}}
                {{^h5picon}}
                {{#icon}}
                <a href="view.php?contextid={{contextid}}&id={{id}}" data-name="{{name}}"
                    class="text-center clamp-2 word-break-all">
                    <img src="{{icon}}" alt="not img" class="mb-2" style="height: 64px; width: 64px;">
                    <p>{{name}}</p>
                </a>
                {{/icon}}
                {{/h5picon}}
            </div>
            {{/coursebank}}
            {{^coursebank}}
            <div class="d-flex flex-wrap p-2" data-region="filearea">
                <div class="w-100 p-3 text-center text-muted">
                    {{#str}} nocontentavailable, local_coursebank {{/str}}
                </div>
            </div>
            {{/coursebank}}
        </div>
    </div>
</div>
{{#js}}
    require(['local_coursebank/search'], function(s) {
        s.init();
    });
{{/js}}